# MentorLagbe client environment variables (front-end keys)
# Copy this file to .env.local and fill in real values.

# Express + MongoDB + BetterAuth backend base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# BetterAuth base URL mounted on the backend
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:5000/api/auth

# ImgBB API key (https://api.imgbb.com) used for profile & tuition banner uploads
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here

# Public site URL (used for canonical links / Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
